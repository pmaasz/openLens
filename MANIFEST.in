# Include documentation files
include README.md
include LICENSE
include requirements.txt
include CHANGELOG.md

# Include setup scripts
include setup_venv.sh
include setup_venv.bat

# data/ and specs/ are gitignored working directories, not source files.
# Material definitions are built into the package and the writable catalog
# lives in the user data directory; a checkout's data/materials.json is only a
# one-time migration source, so it must not leak into a release from whoever
# happened to have one. Including it made the sdist depend on local state: a
# clean checkout shipped no catalog, a developer tree shipped theirs.

# Include documentation directory
recursive-include docs *.md
recursive-include docs *.rst
recursive-include docs *.py
recursive-include docs Makefile

# Include the runnable demos (the library modules no longer carry them)
recursive-include examples *.py


# Exclude compiled Python files
global-exclude __pycache__
global-exclude *.py[co]

# Exclude development files
exclude .gitignore
exclude .git*
exclude openlens.db
recursive-exclude tests *
recursive-exclude venv *
recursive-exclude .idea *
